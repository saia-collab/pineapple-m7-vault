  def compress_prompt(self, prompt: str, compression_rate: float = 0.5) -> dict:\n","        \"\"\"\n","        Compresses the given prompt by removing low-value tokens.\n","\n","        Parameters:\n","        - prompt (str): The original prompt text.\n","        - compression_rate (float): The rate of compression (0 < compression_rate < 1).\n","\n","        Returns:\n","        - dict: A dictionary containing the original prompt, compressed prompt, and details about the compression process.\n","        \"\"\"\n","        # Tokenize the prompt\n","        inputs = self.tokenizer(prompt, return_tensors=\"pt\")\n","        input_ids = inputs[\"input_ids\"]\n","\n","        # Get model output logits\n","        with torch.no_grad():\n","            logits = self.model(input_ids).logits\n","\n","        # Compute token importance scores\n","        importance_scores = torch.norm(logits, dim=-1).squeeze()\n","\n","        # Calculate number of tokens to keep\n","        num_tokens_to_keep = int(len(input_ids[0]) * compression_rate)\n","\n","        # Get the indices of the most important tokens\n","        top_indices = torch.topk(importance_scores, num_tokens_to_keep).indices\n","        top_indices = top_indices.sort().values\n","\n","        # Reconstruct the compressed prompt\n","        compressed_ids = input_ids[0][top_indices]\n","        compressed_prompt = self.tokenizer.decode(compressed_ids, skip_special_tokens=True)\n","\n","        # Create a summary of the compression process\n","        removed_tokens = [self.tokenizer.decode([token_id]) for token_id in input_ids[0] if token_id not in compressed_ids]\n","        retained_tokens = [self.tokenizer.decode([token_id]) for token_id in compressed_ids]\n","        summary = {\n","            \"original_prompt\": prompt,\n","            \"compressed_prompt\": compressed_prompt,\n","            \"num_tokens_removed\": len(removed_tokens),\n","            \"num_tokens_retained\": len(retained_tokens),\n","            \"removed_tokens\": removed_tokens,\n","            \"retained_tokens\": retained_tokens\n","        }\n","\n","        return summary\n","\n","# Google Colab Cell for User Interaction\n","def user_friendly_interface():\n","    \"\"\"\n","    Provides a sophisticated interface for users to input a prompt, get a compressed version, and see a detailed summary.\n","    Optionally, allows users to simulate both original and compressed prompts with GPT-4o.\n","    \"\"\"\n","    prompt = input(\"Enter your prompt: \")\n","    compressor = SophisticatedPromptCompressor()\n","    summary = compressor.compress_prompt(prompt)\n","\n","    # Display results in a beautiful HTML format\n","    html_content = f\"\"\"\n","    <div style=\"font-family: Arial, sans-serif; line-height: 1.6;\">\n","        <h2 style=\"color: #4CAF50;\">Prompt Compression Results</h2>\n","        <div style=\"background-color: #f9f9f9; padding: 15px; border-radius: 8px;\">\n","            <h3>Original Prompt:</h3>\n","            <p style=\"color: #333;\">{summary['original_prompt']}</p>\n","        </div>\n","        <div style=\"background-color: #f0f0f0; padding: 15px; border-radius: 8px; margin-top: 10px;\">\n","            <h3>Compressed Prompt:</h3>\n","            <p style=\"color: #333;\">{summary['compressed_prompt']}</p>\n","        </div>\n","        <div style=\"margin-top: 20px;\">\n","            <h3>Summary of Compression:</h3>\n","            <ul>\n","                <li><strong>Number of Tokens Removed:</strong> {summary['num_tokens_removed']}</li>\n","                <li><strong>Number of Tokens Retained:</strong> {summary['num_tokens_retained']}</li>\n","            </ul>\n","        </div>\n","        <div style=\"margin-top: 10px;\">\n","            <h4>Removed Tokens:</h4>\n","            <p style=\"color: #d9534f;\">{', '.join(summary['removed_tokens'])}</p>\n","        </div>\n","        <div style=\"margin-top: 10px;\">\n","            <h4>Retained Tokens:</h4>\n","            <p style=\"color: #5bc0de;\">{', '.join(summary['retained_tokens'])}</p>\n","        </div>\n","    </div>\n","    \"\"\"\n","    display(HTML(html_content))\n","\n","    # Ask if user wants to simulate both prompts with GPT-4o\n","    simulate = input(\"Do you want to simulate both prompts with GPT-4o? (yes/no): \").strip().lower()\n","    if simulate == \"yes\":\n","        api_key = input(\"Please enter your OpenAI API key: \").strip()\n","        client = OpenAI(api_key=api_key)\n","\n","        # Simulate original prompt\n","        print(\"\\nSimulating Original Prompt...\\n\")\n","        original_completion = client.chat.completions.create(\n","            model=\"gpt-4o-mini\",\n","            messages=[\n","                {\"role\": \"system\", \"content\": \"You are an assistant.\"},\n","                {\"role\": \"user\", \"content\": summary['original_prompt']}\n","            ]\n","        )\n","        print(\"Assistant (Original Prompt): \" + original_completion.choices[0].message.content)\n","\n","        # Simulate compressed prompt\n","        print(\"\\nSimulating Compressed Prompt...\\n\")\n","        compressed_completion = client.chat.completions.create(\n","            model=\"gpt-4o-mini\",\n","            messages=[\n","                {\"role\": \"system\", \"content\": \"You are an assistant.\"},\n","                {\"role\": \"user\", \"content\": summary['compressed_prompt']}\n","            ]\n","        )\n","        print(\"Assistant (Compressed Prompt): \" + compressed_completion.choices[0].message.content)"]},{"cell_type":"markdown","source":["# Results"],"metadata":{"id":"M99ciXWzwqRf"}},{"cell_type":"code","source":["# To use in Google Colab, simply run:\n","user_friendly_interface()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"referenced_widgets":["eacba5b090fb4ac1a9ffc4e14b952524","b7484ee261944c95890316d09a561d10","de1d64e7ddd14647ac322147a9875490","7dea522819034518b6d8662c507bfdb7","0bd73d