# ==============================================================================
# PINEAPPLE M7 AGENT OS — ENVIRONMENT TEMPLATE
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env (it's in .gitignore). Repo is public.
# ==============================================================================

# --- Local server / ports ---
# 3939 = M7 Command Center (server.js). NOT 3737 — the Agentic OS pack
# hardcodes PORT=3737 in its own start script, so they collided.
# Port map: 3000 SEO Office · 3001 OpenSEO · 3100 Paperclip · 3737 Agentic OS
#           3939 M7 Command Center · 9119 Hermes dashboard
PORT=3939
NODE_ENV=development

# --- Core AI models & routing (OpenRouter recommended to dodge token walls) ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.6
LOCAL_FALLBACK_MODEL=qwen2.5-coder:7b

# --- Google Search Console / SEO (GSC) ---
GSC_SITE_URL=https://pineapplecontractors.com
GSC_SERVICE_ACCOUNT_JSON=04_Tech_Lab/config/gsc-service-account.json
GSC_PROPERTY_ID=your-gsc-property-id-here

# --- Database mappings (lightweight local SQLite — filesystem-first memory) ---
AGENT_LOG_DB=04_Tech_Lab/logs/system_logs.db
SHARED_MEMORY_FILE=03_Knowledge_Mat/SHARED_MEMORY.md
VAULT_ROOT=C:/Pineapple Contractors M7

# --- Obsidian Local REST API (vault as memory) ---
OBSIDIAN_API_URL=http://127.0.0.1:27123
OBSIDIAN_API_KEY=your-obsidian-local-rest-api-key-here

# --- Messaging gateways (optional — only if you wire Telegram/Discord) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=

# --- Secret placeholder array (fill only what you use) ---
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
HIGGSFIELD_API_KEY=
META_ADS_TOKEN=

# --- Security & guardrails (KEEP THESE — they enforce Outbox Shield) ---
AUTH_USER=m7-admin
AUTH_PASS=your-secure-ten-character-password-here
AUTH_COOKIE_SECURE=false
HERMES_HOST_LOCK=local
HERMES_ALLOW_POLICY_WRITE=false
HERMES_ALLOW_CRON_WRITE=false
HERMES_ALLOW_WORKSPACE_WRITE=false
