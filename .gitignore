# ============================================================
# M7 .gitignore — keep media + secrets OUT of GitHub
# Your repo is PUBLIC — never commit keys or 28GB of video.
# ============================================================

# --- SECRETS (never commit) ---
.env
*.env
**/.env
.env.local
**/.env.local
.env.*
**/.env.*
keys*
*keys.txt
04_Tech_Lab/config/.env
04_Tech_Lab/config/*_config.json
04_Tech_Lab/config/antigravity_mcp.json
04_Tech_Lab/config/claude_desktop_obsidian_mcp.json
.obsidian/plugins/obsidian-local-rest-api/data.json
.obsidian/plugins/mcp-tools/data.json
*secret*
*apikey*
*.key

# --- BIG MEDIA (too large for GitHub; keep in cloud/external) ---
02_Media_Vault/
**/*.mp4
**/*.MP4
**/*.mov
**/*.MOV
**/*.zip
**/*.psd

# --- machine / build junk ---
.obsidian/
legacy_backup/
04_Tech_Lab/_agentos_backups/
node_modules/
**/node_modules/
**/.next/
**/.turbo/
**/_Archive*/
Launcher_Archive/
__pycache__/
*.pyc
.tmp.driveupload/
desktop.ini
**/desktop.ini
04_Tech_Lab/logs/
04_Tech_Lab/checkpoints/

# --- keep everything else: playbooks, scripts, dashboards, SOPs ---
.wp_secrets.env
04_Tech_Lab/scripts/.wp_secrets.env

# Agent OS local build (huge - never commit node_modules/.next)
04_Tech_Lab/Pineapple_Agent_OS/
04_Tech_Lab/_agentos_backups/
04_Tech_Lab/logs/

# third-party skill/plugin reference library (clone-only)
04_Tech_Lab/playbook_resources/

# third-party skill clones (review before running)
04_Tech_Lab/vendor/claude-obsidian/
04_Tech_Lab/vendor/claude-watch/
04_Tech_Lab/vendor/claude-video/
04_Tech_Lab/vendor/claude-seo/
04_Tech_Lab/vendor/claude-cybersecurity/
04_Tech_Lab/vendor/skill-forge/
04_Tech_Lab/vendor/wp-mcp-ultimate/
